rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- stará aplikace (beze změny) ----------
    // Po zadání hesla party dostane anonymní identita razítko partyMember:true.
    function isPartyMember() {
      // Stará aplikace funguje jen do přepnutí na novou (1. 12. 2026, 1:00 SEČ).
      return request.auth != null && request.auth.token.partyMember == true
        && request.time < timestamp.date(2026, 12, 1);
    }

    // ---------- nová aplikace ----------
    // E-mail správce — stejný jako v config.js (ADMIN_EMAILS), malými písmeny.
    function isAdminEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['l.juracka@gmail.com'];
    }

    function memberPath() {
      return /databases/$(database)/documents/v2_members/$(request.auth.uid);
    }

    // Schválený člen nové aplikace (přihlášený přes Google nebo e-mail).
    // Anonymní identity staré aplikace se tu odfiltrují hned na začátku,
    // aby kvůli nim Firestore zbytečně nečetl v2_members.
    function isV2Approved() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(memberPath())
        && get(memberPath()).data.status == 'approved';
    }

    function isV2Admin() {
      return isV2Approved() && get(memberPath()).data.role == 'admin';
    }

    // Všechno: stará aplikace čte i zapisuje, nová (zkušební provoz) jen čte.
    // Výjimka: omezené check-iny (ciLimited) a uložené skupiny (ciGroups) mají vlastní
    // pravidla níže — obecné „čti všechno“ na ně nesmí platit, jinak by je viděl každý.
    function isPrivateCol(col) {
      return col in ['ciLimited', 'ciGroups'];
    }
    // Stará aplikace (heslo party) — beze změny, končí 1. 12. 2026.
    match /{document=**} {
      allow read, write: if isPartyMember();
    }
    match /{col}/{document=**} {
      allow read: if isV2Approved() && !isPrivateCol(col);
    }
    // Skupinové dotazy (collectionGroup) — pravidlo výše s názvem kolekce je nepokryje,
    // proto zvlášť. Omezené check-iny mají komentáře v „lcomments“, sem nespadají.
    match /{path=**}/comments/{id} { allow read: if isV2Approved(); }
    match /{path=**}/checkins/{id} { allow read: if isV2Approved(); }
    match /{path=**}/attendees/{id} { allow read: if isV2Approved(); }
    match /{path=**}/declines/{id} { allow read: if isV2Approved(); }
    match /{path=**}/likes/{id} { allow read: if isV2Approved(); }
    match /{path=**}/items/{id} { allow read: if isV2Approved(); }
    match /{path=**}/times/{id} { allow read: if isV2Approved(); }

    // Členové nové aplikace.
    match /v2_members/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isV2Approved());

      // Žádost o přijetí (pending), nebo rovnou správce, pokud e-mail sedí.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && (
          (request.resource.data.status == 'pending' && request.resource.data.role == 'member')
          || (isAdminEmail() && request.resource.data.status == 'approved' && request.resource.data.role == 'admin')
        );

      // Správce schvaluje a mění role; každý si smí změnit jen svoje jméno
      // a tajný token pro odběr kalendáře.
      allow update: if isV2Admin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'icsToken'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 30
            && (!('icsToken' in request.resource.data)
                || (request.resource.data.icsToken is string
                    && request.resource.data.icsToken.size() >= 20
                    && request.resource.data.icsToken.size() <= 80)));

      allow delete: if isV2Admin() || (request.auth != null && request.auth.uid == uid);
    }

    // Chat a check-iny party — nová aplikace je píše naostro (stejně jako stará).
    match /chats/{thread} {
      allow read, write: if isV2Approved();
      match /messages/{msg} {
        allow read, write: if isV2Approved();
      }
    }
    // Zvoneček check-inů (settings/placeCheckins → enabled{jméno: true/false}) —
    // nová aplikace smí měnit jen tohle pole (stará zapisuje přes heslo party).
    match /settings/placeCheckins {
      allow read: if isV2Approved();
      allow create: if isV2Approved() && request.resource.data.keys().hasOnly(['enabled']);
      // každý mění jen svůj vlastní zvoneček
      allow update: if isV2Approved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled'])
        && request.resource.data.enabled.diff(resource.data.get('enabled', {})).affectedKeys()
             .hasOnly([get(memberPath()).data.name]);
    }

    match /placeCheckins/{id} {
      allow read, write: if isV2Approved();
      match /comments/{c} {
        allow read, write: if isV2Approved();
      }
    }

    // Omezený check-in („Jen já“ / „Vybraní“): číst, reagovat a komentovat smí jen
    // lidé v poli visibleTo (seznam jmen, autor je v něm vždy). Seznam mění jen autor.
    function myV2Name() {
      return get(memberPath()).data.name;
    }
    match /ciLimited/{id} {
      allow read: if isV2Approved() && myV2Name() in resource.data.visibleTo;
      allow create: if isV2Approved()
        && request.resource.data.user == myV2Name()
        && request.resource.data.visibleTo is list
        && request.resource.data.visibleTo.size() <= 60
        && myV2Name() in request.resource.data.visibleTo;
      allow update: if isV2Approved()
        && myV2Name() in resource.data.visibleTo
        && request.resource.data.user == resource.data.user
        && (resource.data.user == myV2Name()
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['coming', 'near', 'nearLoc', 'emojis', 'commentCount']))
        && request.resource.data.visibleTo is list
        && resource.data.user in request.resource.data.visibleTo;
      allow delete: if isV2Approved() && resource.data.user == myV2Name();
      match /lcomments/{c} {
        allow read, write: if isV2Approved()
          && myV2Name() in get(/databases/$(database)/documents/ciLimited/$(id)).data.visibleTo;
      }
    }

    // Uložené skupiny lidí pro omezené check-iny — každý vidí a mění jen svoje.
    match /ciGroups/{uid} {
      allow read, write: if isV2Approved() && request.auth.uid == uid;
    }

    // Lajky u akcí (stejné místo jako stará aplikace). Každý smí dát nebo
    // vzít jen svůj vlastní lajk — dokument se jmenuje jeho jménem.
    match /events/{ev}/likes/{name} {
      allow read: if isV2Approved();
      allow write: if isV2Approved() && get(memberPath()).data.name == name;
    }

    // Docházka (Jdu / Nejdu) — stejná místa jako stará aplikace. Každý mění
    // jen svoji odpověď; správce smí dodatečně opravit „Zúčastnili se“.
    match /events/{ev}/attendees/{name} {
      allow write: if isV2Approved() && (get(memberPath()).data.name == name || isV2Admin());
    }
    match /events/{ev}/declines/{name} {
      allow write: if isV2Approved() && (get(memberPath()).data.name == name || isV2Admin());
    }
    // „Jsem na místě“ v den akce.
    match /events/{ev}/checkins/{name} {
      allow write: if isV2Approved() && get(memberPath()).data.name == name;
    }
    // Co přinést.
    match /bringLists/{ev}/items/{item} {
      allow create, update: if isV2Approved();
      allow delete: if isV2Approved()
        && (resource.data.addedBy == get(memberPath()).data.name || isV2Admin());
    }

    // Komentáře u akcí: psát smí každý schválený člen pod svým jménem, mazat
    // jen svoje; reakce (emoji) mění jen pole reactions.
    match /events/{ev}/comments/{c} {
      allow create: if isV2Approved()
        && request.resource.data.user == get(memberPath()).data.name
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update: if isV2Approved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      allow delete: if isV2Approved() && resource.data.user == get(memberPath()).data.name;
    }

    // Profilové fotky (zmenšené JPEG). Každý mění jen svoji.
    match /v2_avatars/{name} {
      allow read: if isV2Approved();
      allow create, update: if isV2Approved() && get(memberPath()).data.name == name
        && request.resource.data.img is string && request.resource.data.img.size() < 200000;
      allow delete: if isV2Approved() && get(memberPath()).data.name == name;
    }

    // Push notifikace: token telefonu (stejně jako stará aplikace). Každý
    // ukládá a maže jen tokeny pod svým jménem.
    match /pushTokens/{token} {
      allow create, update: if isV2Approved() && request.resource.data.user == get(memberPath()).data.name;
      allow delete: if isV2Approved() && resource.data.user == get(memberPath()).data.name;
    }

    // Ankety party (polls) a hipnutí (pokes) — stejně jako stará aplikace.
    match /polls/{id} {
      allow create: if isV2Approved() && request.resource.data.createdBy == get(memberPath()).data.name;
      allow update: if isV2Approved();
    }
    match /pokes/{id} {
      allow create: if isV2Approved() && request.resource.data.from == get(memberPath()).data.name;
    }

    // Náklady akce — zadává a upravuje jen správce, číst smí všichni schválení.
    match /expensePdfs/{ev} {
      allow write: if isV2Admin();
    }

    // Hry v chatu (piškvorky, lodě, pexeso, sudoku). Hrát smí jen ti dva, kdo jsou ve hře.
    match /v2_games/{id} {
      allow read: if isV2Approved();
      allow create: if isV2Approved()
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && get(memberPath()).data.name in request.resource.data.players;
      allow update: if isV2Approved()
        && get(memberPath()).data.name in resource.data.players
        && request.resource.data.players == resource.data.players;
    }

    // Historie zrušených účastí (pro profil). Zapisuje každý jen svoje, číst může celá parta.
    match /v2_attendLog/{id} {
      allow create: if isV2Approved() && request.resource.data.user == get(memberPath()).data.name;
    }

    // Sudoku dne: každý zapisuje jen svůj výsledek, číst může celá parta.
    match /v2_sudoku/{day}/times/{name} {
      allow read: if isV2Approved();
      allow write: if isV2Approved()
        && get(memberPath()).data.name == name
        && request.resource.data.name == name;
    }

    // Online stav (stejně jako stará aplikace: presence/{jméno}.lastActive).
    match /presence/{name} {
      allow read, write: if isV2Approved();
    }

    // Testovací chat a check-iny nové aplikace (zkušební provoz — parta je nevidí).
    match /v2_chats/{thread}/messages/{msg} {
      allow read, write: if isV2Approved();
    }
    match /v2_checkins/{id} {
      allow read, write: if isV2Approved();
      match /comments/{c} {
        allow read, write: if isV2Approved();
      }
    }

    // Fotky v hlavičce akcí (zmenšené JPEG jako dataURL, do ~1 MB).
    match /v2_covers/{id} {
      allow read: if isV2Approved();
      allow create, update: if isV2Approved()
        && request.resource.data.img is string
        && request.resource.data.img.size() < 1000000;
      allow delete: if isV2Approved();
    }

    // Akce nové aplikace. Import z kalendáře smí jen správce; testovací akce
    // smí zakládat každý schválený člen a upravovat ten, kdo je založil.
    match /v2_akce/{id} {
      allow read: if isV2Approved();
      allow create: if isV2Admin()
        || (isV2Approved() && request.resource.data.isTest == true
            && request.resource.data.createdByUid == request.auth.uid);
      allow update: if isV2Admin()
        || (isV2Approved() && resource.data.isTest == true
            && resource.data.createdByUid == request.auth.uid
            && request.resource.data.isTest == true);
      allow delete: if isV2Admin()
        || (isV2Approved() && resource.data.isTest == true
            && resource.data.createdByUid == request.auth.uid);

      // Docházka, komentáře a věci u testovacích akcí.
      match /{sub=**} {
        allow read: if isV2Approved();
        allow write: if isV2Approved()
          && get(/databases/$(database)/documents/v2_akce/$(id)).data.isTest == true;
      }
    }
  }
}
